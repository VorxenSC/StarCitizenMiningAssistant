<Project Sdk="Microsoft.NET.Sdk">

  <!-- Screen capture (GDI BitBlt of small regions only), image preprocessing,
       Windows.Media.Ocr and the scan pipeline. Never touches the game process. -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>MiningAssistant.Vision</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiningAssistant.Core\MiningAssistant.Core.csproj" />
  </ItemGroup>

</Project>

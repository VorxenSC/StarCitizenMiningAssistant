<Window x:Class="MiningAssistant.App.Windows.RequirementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VorxenWindow}" Background="{StaticResource DialogBg}"
        Icon="/Assets/app.ico"
        Title="Mining Assistant by Vorxen — Before you start"
        Width="720" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Num" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#161F2B" />
            <Setter Property="BorderBrush" Value="#2F3B4B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="NumText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource TextBright}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,4" />
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="22.4" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Step" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="44,36,44,36">
            <!-- header -->
            <DockPanel>
                <TextBlock x:Name="WelcomeText" DockPanel.Dock="Right" VerticalAlignment="Center" FontFamily="{StaticResource HeadingFont}"
                           FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Accent}" Margin="12,0,0,0" />
                <StackPanel Orientation="Horizontal">
                    <Image Source="{StaticResource LogoMark}" Height="58" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="BEFORE YOU START" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="28"
                               Foreground="{StaticResource TextBright}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="The app reads the screen. For it to work, the game must look like this:" Foreground="{StaticResource TextMuted}"
                       FontSize="15" TextWrapping="Wrap" Margin="0,14,0,0" />

            <!-- what was detected on this PC -->
            <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,26,0,26">
                <ItemsControl x:Name="DetectedList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,5">
                                <ContentControl x:Name="Mark" DockPanel.Dock="Left" Style="{StaticResource Icon}" Width="18" Height="18" VerticalAlignment="Top"
                                                Tag="{StaticResource IconCheck}" Foreground="{StaticResource Ok}" Margin="0,1,12,0" />
                                <TextBlock x:Name="Line" Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" />
                            </DockPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter TargetName="Mark" Property="Tag" Value="{StaticResource IconCircleX}" />
                                    <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Bad}" />
                                    <Setter TargetName="Line" Property="Foreground" Value="#FFC2C6" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- the eight conditions -->
            <DockPanel Style="{StaticResource Step}">
                <Border Style="{StaticResource Num}"><TextBlock Text="1" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Display mode: Borderless or Windowed" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}" Text="Star Citizen → Graphics → Window Mode. Exclusive Fullscreen hides the game image from other programs, so the app cannot see it." />
                </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Step}">
                <Border Style="{StaticResource Num}"><TextBlock Text="2" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Resolution: 1920×1080 (Full HD) or higher" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}" Text="1080p, 1440p, 4K and ultrawide all work, at any Windows display scale (100–200%). In Windowed mode keep the game window at least about 1000 px tall." />
                </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Step}">
                <Border Style="{StaticResource Num}"><TextBlock Text="3" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Keep the center of the screen clear" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}">
                        <Run Text="The RS code (amber plate with a pin icon, e.g." />
                        <InlineUIContainer BaselineAlignment="Center">
                            <Viewbox Width="11" Height="13" Margin="1,0,0,0">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource IconPin}" Stroke="{StaticResource Accent}" StrokeThickness="2.4" StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </InlineUIContainer>
                        <Run Text="3,585) appears just above the center reticle. Do not put windows or overlays (browser, Discord, this panel) over the middle of the game. The control panel minimizes itself when you press START." />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Step}">
                <Border Style="{StaticResource Num}"><TextBlock Text="4" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Original HUD colors" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}" Text="The app looks for the amber RS plate of the ship HUD (Prospector). Turn off anything that changes the game's colors: NVIDIA Filters / Freestyle, AMD / ReShade presets, Windows color filters. If readings fail with Windows HDR on, try with HDR off." />
                </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Step}">
                <Border Style="{StaticResource Num}"><TextBlock Text="5" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Game on the monitor chosen in the app" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}" Text="By default the main monitor. To change it: Advanced settings → Game monitor." />
                </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Step}">
                <Border Style="{StaticResource Num}"><TextBlock Text="6" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Do not run the game as administrator" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}">
                        <Run Text="If Star Citizen / the RSI Launcher runs as administrator, Windows blocks the hotkeys (" /><Run Text="" />
<InlineUIContainer BaselineAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource InlineKbd}"><TextBlock Text="Page Up" Style="{StaticResource KeyText}" /></Border>
                                <Border Style="{StaticResource InlineKbd}" Margin="4,0"><TextBlock Text="Page Down" Style="{StaticResource KeyText}" /></Border>
                                <Border Style="{StaticResource InlineKbd}"><TextBlock Text="\" Style="{StaticResource KeyText}" /></Border>
                            </StackPanel>
                        </InlineUIContainer><Run Text=") inside the game. Run both normally (or both as administrator)." />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Step}">
                <Border Style="{StaticResource Num}"><TextBlock Text="7" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Start, then switch to the game" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}" Text="Click START and switch to Star Citizen during the 5-second countdown. Ping the ship scanner: when the amber RS plate appears, the overlay shows the ore." />
                </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Step}" Margin="0">
                <Border Style="{StaticResource Num}"><TextBlock Text="8" Style="{StaticResource NumText}" /></Border>
                <StackPanel>
                    <TextBlock Text="Windows 10 (2004 or newer) or Windows 11, 64-bit" Style="{StaticResource StepTitle}" />
                    <TextBlock Style="{StaticResource StepText}" Text="Uses the built-in Windows text recognition (English pack, usually already installed). Nothing is sent over the internet unless you turn on GitHub contributions." />
                </StackPanel>
            </DockPanel>

            <!-- footer -->
            <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,30,0,0" Padding="0,20,0,0">
                <TextBlock FontSize="13.5" LineHeight="21.6" Foreground="{StaticResource TextDim}" TextWrapping="Wrap">
                    <Run Text="Something not working? Run the self-test (it checks all of the above that can be checked), and press" />
                    <InlineUIContainer BaselineAlignment="Center"><Border Style="{StaticResource InlineKbd}"><TextBlock Text="Page Down" Style="{StaticResource KeyText}" /></Border></InlineUIContainer>
                    <Run Text="in the game when the code is visible but not read — that saves a snapshot for analysis." />
                </TextBlock>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Run self-test" MinHeight="46" Padding="24,0" FontSize="15" Click="SelfTest_Click" />
                <Button Content="GOT IT — LET'S MINE" Style="{StaticResource PrimaryBtn}" MinHeight="46" Padding="26,0" Margin="10,0,0,0"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

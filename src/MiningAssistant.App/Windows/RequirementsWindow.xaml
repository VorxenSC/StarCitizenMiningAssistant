<Window x:Class="MiningAssistant.App.Windows.RequirementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.ico"
        Title="Mining Assistant by Vorxen — Before you start"
        Width="620" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FF0F172A" Foreground="#FFE2E8F0" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="Rule" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Detail" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#FF94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,18">
        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#FF4ADE80">
            <Run Text="⛏ BEFORE YOU START" />
            <Run x:Name="WelcomeRun" Text="" FontSize="14" FontWeight="SemiBold" Foreground="#FFFACC15" />
        </TextBlock>
        <TextBlock Text="The app reads the screen. For it to work, the game must look like this:" Foreground="#FF94A3B8" Margin="0,4,0,12" />

        <!-- What we detected on this PC -->
        <Border Background="#FF111827" CornerRadius="6" Padding="12,8" BorderBrush="#FF334155" BorderThickness="1" Margin="0,0,0,14">
            <ItemsControl x:Name="DetectedList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="{Binding Mark}" Foreground="{Binding Color}" FontWeight="Bold" Width="22" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Style="{StaticResource Rule}"><Run Text="1. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Display mode: Borderless or Windowed" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="Star Citizen → Graphics → Window Mode. Exclusive Fullscreen hides the game image from other programs, so the app cannot see it." />

        <TextBlock Style="{StaticResource Rule}"><Run Text="2. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Resolution: 1920×1080 (Full HD) or higher" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="1080p, 1440p, 4K and ultrawide all work, at any Windows display scale (100–200%). In Windowed mode keep the game window at least about 1000 px tall." />

        <TextBlock Style="{StaticResource Rule}"><Run Text="3. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Keep the center of the screen clear" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="The RS code (amber plate with a pin icon, e.g. 📍 3,585) appears just above the center reticle. Do not put windows or overlays (browser, Discord, this panel) over the middle of the game. The control panel minimizes itself when you press START." />

        <TextBlock Style="{StaticResource Rule}"><Run Text="4. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Original HUD colors" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="The app looks for the amber RS plate of the ship HUD (Prospector). Turn off anything that changes the game's colors: NVIDIA Filters / Freestyle, AMD / ReShade presets, Windows color filters. If readings fail with Windows HDR on, try with HDR off." />

        <TextBlock Style="{StaticResource Rule}"><Run Text="5. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Game on the monitor chosen in the app" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="By default the main monitor. To change it: Advanced settings → Game monitor." />

        <TextBlock Style="{StaticResource Rule}"><Run Text="6. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Do not run the game as administrator" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="If Star Citizen / the RSI Launcher runs as administrator, Windows blocks the hotkeys ([ ] \) inside the game. Run both normally (or both as administrator)." />

        <TextBlock Style="{StaticResource Rule}"><Run Text="7. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Start, then switch to the game" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="Click START and switch to Star Citizen during the 5-second countdown. Ping the ship scanner: when the amber RS plate appears, the overlay shows the ore." />

        <TextBlock Style="{StaticResource Rule}"><Run Text="8. " FontWeight="Bold" Foreground="#FFFACC15" /><Run Text="Windows 10 (2004 or newer) or Windows 11, 64-bit" FontWeight="SemiBold" /></TextBlock>
        <TextBlock Style="{StaticResource Detail}" Text="Uses the built-in Windows text recognition (English pack, usually already installed). Nothing is sent over the internet unless you turn on GitHub contributions." />

        <TextBlock Foreground="#FF94A3B8" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="Something not working? Run the self-test (it checks all of the above that can be checked), and press ] in the game when the code is visible but not read — that saves a snapshot for analysis." />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Got it — let's mine" FontWeight="SemiBold" Padding="18,6" Margin="8,0,0,0" Click="Ok_Click" IsDefault="True"
                    Background="#FF16A34A" Foreground="White" BorderBrush="#FF15803D" />
            <Button DockPanel.Dock="Right" Content="Run self-test" Padding="12,6" Click="SelfTest_Click" />
        </DockPanel>
    </StackPanel>
</Window>

<Window x:Class="MiningAssistant.App.Windows.UnknownSignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.ico"
        Title="Mining Assistant by Vorxen — Unknown signature"
        WindowStyle="ToolWindow" ResizeMode="NoResize" SizeToContent="Height" Width="380"
        Topmost="True" ShowActivated="False" ShowInTaskbar="True"
        Background="{StaticResource CardBg}" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource BodyFont}" FontSize="13">
    <StackPanel Margin="14,12">
        <DockPanel>
            <TextBlock x:Name="QueueText" DockPanel.Dock="Right" Foreground="#FF94A3B8" FontSize="11" VerticalAlignment="Center" />
            <TextBlock Text="❓ UNKNOWN SIGNATURE" Foreground="#FFC084FC" FontWeight="Bold" FontSize="14" />
        </DockPanel>
        <DockPanel Margin="0,8,0,0">
            <Border DockPanel.Dock="Left" Background="Black" CornerRadius="4" Margin="0,0,12,0" MaxWidth="150" MaxHeight="60"
                    BorderBrush="#FF334155" BorderThickness="1">
                <Image x:Name="PlateImage" Stretch="Uniform" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="RsText" Text="RS 5,000" FontSize="22" FontWeight="Bold" Foreground="#FFF1F5F9" />
                <TextBlock x:Name="WhenText" Foreground="#FF94A3B8" FontSize="11" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="What is it?" Foreground="#FF94A3B8" Margin="0,12,0,3" />
        <ComboBox x:Name="NameBox" IsEditable="True" FontSize="14" ToolTip="Pick a known material or type a new name" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="How many rocks / deposits?" Foreground="#FF94A3B8" Margin="0,0,0,3" />
                <TextBox x:Name="CountBox" Text="1" FontSize="14" TextChanged="CountBox_TextChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Type" Foreground="#FF94A3B8" Margin="0,0,0,3" />
                <ComboBox x:Name="KindBox" FontSize="13">
                    <ComboBoxItem Content="Ore (ship mining)" Tag="Ore" IsSelected="True" />
                    <ComboBoxItem Content="Asteroid type" Tag="AsteroidType" />
                    <ComboBoxItem Content="FPS / hand deposit" Tag="FpsDeposit" />
                    <ComboBoxItem Content="ROC deposit" Tag="RocDeposit" />
                    <ComboBoxItem Content="Salvage" Tag="Salvage" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="BaseText" Foreground="#FF94A3B8" FontSize="11.5" Margin="0,4,0,0" />

        <TextBlock Text="Notes (optional)" Foreground="#FF94A3B8" Margin="0,10,0,3" />
        <TextBox x:Name="NotesBox" FontSize="13" />

        <TextBlock Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"
                   Text="Saved only on this PC. To help others, share it later from the control panel (Advanced settings → Share on Discord / GitHub)." />

        <WrapPanel Margin="0,14,0,0">
            <Button Content="✓ Save" FontWeight="SemiBold" Padding="16,5" Margin="0,0,6,0" Click="Save_Click" IsDefault="True" />
            <Button Content="Ignore" Padding="12,5" Margin="0,0,6,0" Click="Ignore_Click" />
            <Button x:Name="NeverButton" Content="Never ask for this RS" Padding="10,5" Click="Never_Click" />
        </WrapPanel>
        <TextBlock x:Name="ErrorText" Foreground="#FFF87171" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0" />
    </StackPanel>
</Window>

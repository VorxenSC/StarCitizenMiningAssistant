<Window x:Class="MiningAssistant.App.Windows.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.ico"
        Title="Mining Assistant — Calibration"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        Background="Black" FontFamily="Segoe UI" Cursor="Cross">
    <Grid>
        <Image x:Name="Shot" Stretch="Fill" />
        <Canvas x:Name="Surface" Background="Transparent"
                MouseLeftButtonDown="Surface_MouseDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseUp" />

        <Border x:Name="Toolbar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,16,0,0"
                Background="#F00F172A" CornerRadius="8" Padding="14,10" Cursor="Arrow"
                BorderBrush="#FF334155" BorderThickness="1">
            <StackPanel>
                <TextBlock Foreground="#FFF1F5F9" FontSize="14" FontWeight="SemiBold"
                           Text="CALIBRATION — choose a region, then drag a box over it on the frozen screenshot" />
                <TextBlock Foreground="#FF94A3B8" FontSize="12" Margin="0,2,0,8" TextWrapping="Wrap" MaxWidth="820"
                           Text="RS search area: draw a LARGE box around where the amber RS plate (pin icon + number) appears, e.g. the central third of the screen. The plate sways with the ship, and the app finds it anywhere inside the box, so bigger is safer. The other regions are saved for the future Detailed Mining mode." />
                <WrapPanel x:Name="RegionButtons" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Save  (Enter)" Padding="14,4" Click="Save_Click" IsDefault="True" />
                    <Button Content="Clear selected region" Padding="10,4" Margin="8,0,0,0" Click="Clear_Click" />
                    <Button Content="Move toolbar ⇅" Padding="10,4" Margin="8,0,0,0" Click="MoveToolbar_Click" />
                    <Button Content="Cancel  (Esc)" Padding="10,4" Margin="8,0,0,0" Click="Cancel_Click" IsCancel="True" />
                    <TextBlock x:Name="Info" Foreground="#FF94A3B8" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

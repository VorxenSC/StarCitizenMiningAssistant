<Window x:Class="MiningAssistant.App.Windows.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mining Assistant — starting"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" IsHitTestVisible="False"
        FontFamily="Bahnschrift, Segoe UI">
    <Border CornerRadius="14" Background="#F00A0E14" BorderBrush="#FFFACC15" BorderThickness="2" Padding="44,22">
        <StackPanel>
            <TextBlock Text="⛏ MINING ASSISTANT" Foreground="#FF94A3B8" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock x:Name="Number" Text="5" Foreground="#FFFACC15" FontSize="120" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,-6,0,-10" />
            <TextBlock x:Name="Caption" Text="SCANNING STARTS IN 5 SECONDS" Foreground="#FFF1F5F9" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="⚠ Switch to the Star Citizen window now" Foreground="#FFFACC15" FontSize="18"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Text="The overlay reads whatever is on this screen once the countdown ends." Foreground="#FF94A3B8" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
    </Border>
</Window>

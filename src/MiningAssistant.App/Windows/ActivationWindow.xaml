<Window x:Class="MiningAssistant.App.Windows.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource VorxenWindow}" Background="{StaticResource DialogBg}"
        Icon="/Assets/app.ico"
        Title="Mining Assistant by Vorxen — Activation"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextLabel}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="40,32,40,30">
        <StackPanel Orientation="Horizontal">
            <Image Source="{StaticResource LogoMark}" Height="58" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="MINING ASSISTANT" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="25"
                       Foreground="{StaticResource TextBright}" VerticalAlignment="Center" Margin="14,0,0,0" />
            <TextBlock Text="by Vorxen" FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" FontSize="15"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="10,5,0,0" />
        </StackPanel>

        <TextBlock Text="Enter your name and the key you received to activate the app." Foreground="{StaticResource TextMuted}"
                   FontSize="14.5" TextWrapping="Wrap" Margin="0,16,0,0" />

        <!-- This PC's code: the key is made for name + this code -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,18,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" MinHeight="38" Padding="14,0" FontSize="13.5" Click="CopyCode_Click" VerticalAlignment="Center"
                        ToolTip="Copies your name and this PC code, ready to send to Vorxen">
                    <TextBlock x:Name="CopyLabel" Text="Copy name + code" />
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="YOUR PC CODE" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                    <TextBox x:Name="PcCodeText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0"
                             FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" FontSize="20" Foreground="{StaticResource Accent}">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <TextBlock Text="No key yet? Send your name and this code to Vorxen. The key only works on this PC."
                               Foreground="{StaticResource TextDim}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,12,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Text="NAME" Style="{StaticResource FieldLabel}" Margin="0,22,0,7" />
        <TextBox x:Name="NameBox" MinHeight="48" FontSize="16" Padding="16,0" />

        <TextBlock Text="KEY" Style="{StaticResource FieldLabel}" Margin="0,16,0,7" />
        <TextBox x:Name="KeyBox" MinHeight="96" FontSize="14" Padding="14,8" FontFamily="{StaticResource MonoFont}" CharacterCasing="Upper"
                 MaxLength="400" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Tag="Paste the key you received (a long block of letters and numbers)" ToolTip="Paste the whole key; spaces, line breaks and dashes do not matter" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" FontSize="13.5" Margin="0,12,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Content="Exit" MinHeight="46" Padding="24,0" FontSize="15" Click="Exit_Click" IsCancel="True" />
            <Button Content="ACTIVATE" Style="{StaticResource PrimaryBtn}" MinHeight="46" Margin="10,0,0,0" Click="Activate_Click" IsDefault="True" />
        </StackPanel>
        <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
            <TextBlock Text="The key is tied to your name and to this PC, and only needs to be entered once."
                       Foreground="{StaticResource TextDim}" FontSize="12.5" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</Window>

<Window x:Class="MiningAssistant.App.Windows.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.ico"
        Title="Mining Assistant by Vorxen — Activation"
        Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#FF0F172A" Foreground="#FFE2E8F0" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="22,18">
        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#FF4ADE80">
            <Run Text="⛏ MINING ASSISTANT" />
            <Run Text="by Vorxen" FontSize="14" FontWeight="SemiBold" Foreground="#FFFACC15" />
        </TextBlock>
        <TextBlock Text="Enter your name and the key you received to activate the app." Foreground="#FF94A3B8"
                   TextWrapping="Wrap" Margin="0,6,0,14" />

        <TextBlock Text="Name" Foreground="#FF94A3B8" Margin="0,0,0,3" />
        <TextBox x:Name="NameBox" FontSize="15" Padding="6,4" />

        <TextBlock Text="Key" Foreground="#FF94A3B8" Margin="0,12,0,3" />
        <TextBox x:Name="KeyBox" FontSize="17" Padding="6,4" FontFamily="Cascadia Mono, Consolas" CharacterCasing="Upper"
                 MaxLength="24" ToolTip="Format XXXX-XXXX-XXXX-XXXX (dashes are optional)" />

        <TextBlock x:Name="ErrorText" Foreground="#FFF87171" TextWrapping="Wrap" Margin="0,10,0,0" />

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Content="Exit" Padding="14,5" Margin="8,0,0,0" Click="Exit_Click" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="Activate" FontWeight="SemiBold" Padding="18,5" Click="Activate_Click" IsDefault="True"
                    Background="#FF16A34A" Foreground="White" BorderBrush="#FF15803D" />
        </DockPanel>
        <TextBlock Text="The key is tied to your name and only needs to be entered once on this PC."
                   Foreground="#FF64748B" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
    </StackPanel>
</Window>

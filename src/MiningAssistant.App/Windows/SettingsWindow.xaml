<Window x:Class="MiningAssistant.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:MiningAssistant.App.Controls"
        Style="{StaticResource VorxenWindow}"
        Icon="/Assets/app.ico"
        Title="Star Citizen Mining Assistant by Vorxen — Control Panel" Width="1180" MinWidth="760" MinHeight="460" SizeToContent="Height"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,12,5" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19.5" />
        </Style>
        <Style x:Key="SmallBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style x:Key="LiveKey" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
        </Style>
    </Window.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="36,28,36,36" MaxWidth="1120">

            <!-- ───────────── header ───────────── -->
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource LogoMark}" Height="68" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="MINING ASSISTANT" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" FontSize="28"
                                   Foreground="{StaticResource TextBright}" VerticalAlignment="Bottom" />
                        <TextBlock Text="by Vorxen" FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{StaticResource Accent}" Margin="12,0,0,3" VerticalAlignment="Bottom" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="WelcomeText" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"
                           FontFamily="{StaticResource HeadingFont}" FontWeight="SemiBold" FontSize="21" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource WelcomeGradient}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="Requirements_Click" MinHeight="34" Padding="12,0" FontSize="13" Margin="0,0,10,0"
                            ToolTip="Conditions for the app to work (display mode, resolution, HUD colors…)">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconList}" Width="14" Height="14" Margin="0,0,7,0" /><TextBlock Text="Requirements" /></StackPanel>
                    </Button>
                    <Border Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource TextDim}" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ───────────── status + actions ───────────── -->
            <Border Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <Border x:Name="StateBar" CornerRadius="11" BorderThickness="1" Padding="18,10,10,10">
                        <DockPanel>
                            <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryBtn}" Click="Start_Click" Padding="20,0"
                                    ToolTip="Starts reading the screen after a 5 s countdown, so you can switch to the game window">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl x:Name="StartIcon" Style="{StaticResource FilledIcon}" Tag="{StaticResource IconPlay}" Margin="0,0,9,0" />
                                    <TextBlock x:Name="StartLabel" Text="START" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Grid Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Ellipse x:Name="StatePulse" RenderTransformOrigin="0.5,0.5" Opacity="0">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale" /></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="StateDot" />
                            </Grid>
                            <TextBlock x:Name="StateText" VerticalAlignment="Center" FontSize="16" TextWrapping="Wrap" Margin="0,0,14,0">
                                <Run x:Name="StateLabel" Text="STARTING…" FontFamily="{StaticResource HeadingFont}" FontWeight="Bold" />
                                <Run x:Name="StateSub" Text="" />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <ctl:FlexWrapPanel Gap="10" Margin="0,18,0,0">
                        <Button Click="Reload_Click" ToolTip="Re-read settings, calibration and materials from disk and restart the scanner, OCR and hotkeys">
                            <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconReload}" Margin="0,0,8,0" /><TextBlock Text="Reload" /></StackPanel>
                        </Button>
                        <Button Click="Restart_Click" ToolTip="Close and start the app again">
                            <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconPower}" Margin="0,0,8,0" /><TextBlock Text="Restart app" /></StackPanel>
                        </Button>
                        <Button Click="Calibrate_Click">
                            <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconTarget}" Margin="0,0,8,0" /><TextBlock Text="Calibrate search area…" /></StackPanel>
                        </Button>
                        <Button Click="Move_Click" ToolTip="Drag the result card, then click again (or double-click the card) to lock">
                            <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconMove}" Margin="0,0,8,0" /><TextBlock Text="Move overlay" /></StackPanel>
                        </Button>
                        <Button Click="Snapshot_Click"
                                ToolTip="Saves this exact moment (whole screen, RS plate, every OCR input and a report) to debug_snapshots — same as the ] key">
                            <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconCamera}" Margin="0,0,8,0" /><TextBlock Text="Debug snapshot" /></StackPanel>
                        </Button>
                        <Button Click="Debug_Click">
                            <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconWindow}" Margin="0,0,8,0" /><TextBlock Text="Debug window" /></StackPanel>
                        </Button>
                    </ctl:FlexWrapPanel>
                </StackPanel>
            </Border>

            <!-- ───────────── functions | checklist + sound alert ───────────── -->
            <ctl:TwoColumnPanel Margin="0,20,0,0">
                <Border Style="{StaticResource Card}" Padding="14,22,14,14">
                    <StackPanel>
                        <ContentControl Style="{StaticResource SectionHeader}" Content="FUNCTIONS" Margin="12,0,0,10" />
                        <CheckBox x:Name="OverlaySwitch" Style="{StaticResource Switch}" Content="Overlay (result card)" Click="OverlaySwitch_Click" />
                        <CheckBox x:Name="LocateSwitch" Style="{StaticResource Switch}" Content="Auto-locate the amber RS plate" Click="Feature_Click"
                                  ToolTip="Finds the pin icon + number anywhere in the search area. Off = read a fixed area as text." />
                        <CheckBox x:Name="HotkeySwitch" Style="{StaticResource Switch}" Content="Hotkeys" Click="Feature_Click" />
                        <CheckBox x:Name="SoundSwitch" Style="{StaticResource Switch}" Content="Sound alerts" Click="Feature_Click" />
                        <CheckBox x:Name="TargetSwitch" Style="{StaticResource Switch}" Content="Only announce target materials" Click="Feature_Click" />
                        <CheckBox x:Name="MissedSwitch" Style="{StaticResource Switch}" Content="Save unreadable captures (diagnostics)" Click="Feature_Click" />
                        <CheckBox x:Name="DebugSwitch" Style="{StaticResource Switch}" Content="Debug mode" Click="Feature_Click" />
                        <CheckBox x:Name="CaptureSwitch" Style="{StaticResource Switch}" Content="Hide overlay from recordings / OBS" Click="Feature_Click" />
                        <CheckBox x:Name="StartupSwitch" Style="{StaticResource Switch}" Content="Open this panel when the app starts" Click="Feature_Click" />
                        <CheckBox x:Name="AutoStartSwitch" Style="{StaticResource Switch}" Content="Start scanning automatically (no countdown)" Click="Feature_Click" />
                        <CheckBox x:Name="MinimizeSwitch" Style="{StaticResource Switch}" Content="Minimize this panel when scanning starts" Click="Feature_Click" />
                        <CheckBox x:Name="AskUnknownSwitch" Style="{StaticResource Switch}" Content="Ask me to name unknown signatures (pop-up)" Click="Feature_Click" />
                        <CheckBox x:Name="ContributeSwitch" Style="{StaticResource Switch}" Content="Send named signatures to GitHub (opt-in)" Click="Contribute_Click"
                                  ToolTip="Sends only the values you typed and the RS plate image to the private project repository, through the GitHub CLI. Nothing is sent while this is off." />
                    </StackPanel>
                </Border>

                <DockPanel LastChildFill="True">
                    <!-- Checklist -->
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <StackPanel>
                            <ContentControl Style="{StaticResource SectionHeader}" Content="CHECKLIST" Margin="0,0,0,10" />
                            <ItemsControl x:Name="HealthList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Box" Padding="4" Margin="0,1" CornerRadius="10" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                            <DockPanel>
                                                <ContentControl x:Name="Mark" DockPanel.Dock="Left" Style="{StaticResource Icon}" Width="20" Height="20" VerticalAlignment="Top"
                                                                Tag="{StaticResource IconCircleCheck}" Foreground="{StaticResource Ok}" Margin="0,0,12,0" />
                                                <TextBlock TextWrapping="Wrap" FontSize="14" LineHeight="20">
                                                    <Run x:Name="TitleRun" Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource TextBright}" />
                                                    <Run x:Name="DetailRun" Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                                                </TextBlock>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter TargetName="Box" Property="Background" Value="#2A1519" />
                                                <Setter TargetName="Box" Property="BorderBrush" Value="#66303A" />
                                                <Setter TargetName="Box" Property="Padding" Value="12" />
                                                <Setter TargetName="Box" Property="Margin" Value="0,3" />
                                                <Setter TargetName="Mark" Property="Tag" Value="{StaticResource IconCircleX}" />
                                                <Setter TargetName="Mark" Property="Foreground" Value="{StaticResource Bad}" />
                                                <Setter TargetName="TitleRun" Property="Foreground" Value="#FFC2C6" />
                                                <Setter TargetName="DetailRun" Property="Foreground" Value="#F0C9CC" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Sound alert for specific signatures (fills the rest of the column) -->
                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                                <ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconBell}" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="SOUND ALERT FOR A SPECIFIC SIGNATURE" Style="{StaticResource SectionTitle}" Margin="10,0,0,0" />
                            </StackPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Click="TestAlert_Click">
                                    <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconBell}" Margin="0,0,8,0" /><TextBlock Text="Test sound" /></StackPanel>
                                </Button>
                                <Button DockPanel.Dock="Right" Content="Save" Margin="10,0,0,0" Click="AlertRs_Commit" />
                                <TextBlock DockPanel.Dock="Left" Text="Beep when RS is" Foreground="{StaticResource TextLabel}" FontSize="14.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="AlertRsBox" MinHeight="44" Tag="e.g. 3585" FontFamily="{StaticResource MonoFont}"
                                         LostFocus="AlertRs_Commit" KeyDown="AlertRsBox_KeyDown"
                                         ToolTip="One or more RS numbers, e.g. 3585, 7170 — press Enter to save. Leave empty to turn off." />
                            </DockPanel>
                            <CheckBox x:Name="AlertMultiplesBox" DockPanel.Dock="Top" Click="AlertRs_Commit" Margin="0,14,0,0">
                                <TextBlock Text="Also for multiples — 3585 also beeps on 7,170, 10,755… (clusters of 2, 3… rocks)" TextWrapping="Wrap" LineHeight="21" />
                            </CheckBox>
                            <TextBlock x:Name="AlertRsHint" Style="{StaticResource Hint}" VerticalAlignment="Bottom" Margin="0,14,0,0" />
                        </DockPanel>
                    </Border>
                </DockPanel>
            </ctl:TwoColumnPanel>

            <!-- ───────────── hotkeys | live ───────────── -->
            <ctl:TwoColumnPanel Margin="0,20,0,0">
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Content="HOTKEYS" Margin="0,0,0,14" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,16,0,0">
                            <Run Text="Work with the game in focus. Keys are only observed, never blocked. Change them in" />
                            <Run Text="config/settings.json" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#B7C5D3" /><Run Text=", then click Reload." />
                        </TextBlock>
                        <ItemsControl x:Name="HotkeyList" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="138" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Kbd}">
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource KbdText}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="14.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Top" Style="{StaticResource SectionHeader}" Content="LIVE — WHAT THE APP SEES" Margin="0,0,0,14" />
                        <Border DockPanel.Dock="Bottom" Background="{StaticResource FieldBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                CornerRadius="11" Padding="16" Margin="0,14,0,0">
                            <ItemsControl x:Name="LiveList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource LiveKey}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" FontSize="13" Margin="14,0,0,0">
                                                <Run Text="{Binding Value, Mode=OneWay}" Foreground="{StaticResource TextMain}" />
                                                <Run Text="{Binding Note, Mode=OneWay}" Foreground="{StaticResource TextDim}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border MinHeight="210" CornerRadius="11" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Background="#070C12" ClipToBounds="True">
                            <Grid>
                                <Rectangle>
                                    <Rectangle.Fill>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H24 V24 H0 Z" />
                                                    <GeometryDrawing Brush="#09FFFFFF" Geometry="M0,0 H24 V1 H0 Z" />
                                                    <GeometryDrawing Brush="#09FFFFFF" Geometry="M0,0 H1 V24 H0 Z" />
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12,32,12,32" MaxHeight="300" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="PreviewHint" Text="no capture yet" Foreground="#4C5D70" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="PreviewMonitor" Margin="14,12" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextFaint}"
                                           HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <TextBlock x:Name="PreviewInterval" Margin="14,12" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource TextFaint}"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>
            </ctl:TwoColumnPanel>

            <!-- ───────────── advanced ───────────── -->
            <Expander x:Name="AdvancedExpander" Header="ADVANCED SETTINGS" Margin="0,20,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Game version (DB)" Style="{StaticResource Label}" />
                        <ComboBox x:Name="VersionBox" Grid.Column="1" Margin="0,4" />
                        <TextBlock Grid.Row="1" Text="Game monitor" Style="{StaticResource Label}" />
                        <ComboBox x:Name="MonitorBox" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                        <TextBlock Grid.Row="2" Text="Location context" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ContextBox" Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <ComboBoxItem Content="Auto (detected from signals)" Tag="Auto" />
                            <ComboBoxItem Content="Space" Tag="Space" />
                            <ComboBoxItem Content="Surface" Tag="Surface" />
                        </ComboBox>
                        <TextBlock Grid.Row="3" Text="Scan interval" Style="{StaticResource Label}" />
                        <ComboBox x:Name="IntervalBox" Grid.Row="3" Grid.Column="1" Margin="0,4">
                            <ComboBoxItem Content="100 ms (fast, more CPU)" Tag="100" />
                            <ComboBoxItem Content="200 ms (default)" Tag="200" />
                            <ComboBoxItem Content="500 ms (light)" Tag="500" />
                            <ComboBoxItem Content="1000 ms (very light)" Tag="1000" />
                        </ComboBox>
                        <TextBlock Grid.Row="4" Text="RS tolerance (±)" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="ToleranceBox" Width="70" />
                            <TextBlock Text="RS units — keep below 7 (ores are 15 apart)" Style="{StaticResource Label}" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="5" Text="Temporal vote" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="VoteMinBox" Width="56" />
                            <TextBlock Text="agreeing of last" Style="{StaticResource Label}" Margin="10,0,10,0" />
                            <TextBox x:Name="VoteWindowBox" Width="56" />
                            <TextBlock Text="frames" Style="{StaticResource Label}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Row="6" Text="Target materials" Style="{StaticResource Label}" />
                        <TextBox x:Name="TargetsBox" Grid.Row="6" Grid.Column="1" Margin="0,4" Tag="e.g. Gold, Tungsten" ToolTip="Comma separated, e.g. Gold, Tungsten" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="SkipBox" Content="Skip frames when nothing changed" />
                        <CheckBox x:Name="ConfidenceBox" Content="Show confidence" />
                        <CheckBox x:Name="IdleBox" Content="Show idle 'scanning' pill" />
                    </WrapPanel>

                    <ContentControl Style="{StaticResource SectionHeader}" Content="OVERLAY POSITION" Margin="0,22,0,10" />
                    <CheckBox x:Name="NextToSignalBox" Content="Follow the RS search area (instead of a fixed position)" Click="Placement_Click" />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Horizontal" Style="{StaticResource Label}" />
                        <Slider x:Name="XSlider" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Overlay_Changed" />
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=XSlider, StringFormat={}{0:P0}}" Style="{StaticResource Label}" Margin="12,0,0,0" />
                        <TextBlock Grid.Row="1" Text="Vertical" Style="{StaticResource Label}" />
                        <Slider x:Name="YSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="0.95" ValueChanged="Overlay_Changed" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=YSlider, StringFormat={}{0:P0}}" Style="{StaticResource Label}" Margin="12,0,0,0" />
                        <TextBlock Grid.Row="2" Text="Scale" Style="{StaticResource Label}" />
                        <Slider x:Name="ScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="0.6" Maximum="2.5" ValueChanged="Overlay_Changed" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=ScaleSlider, StringFormat={}{0:F1}×}" Style="{StaticResource Label}" Margin="12,0,0,0" />
                        <TextBlock Grid.Row="3" Text="Opacity" Style="{StaticResource Label}" />
                        <Slider x:Name="OpacitySlider" Grid.Row="3" Grid.Column="1" Minimum="0.3" Maximum="1" ValueChanged="Overlay_Changed" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" Style="{StaticResource Label}" Margin="12,0,0,0" />
                    </Grid>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="Apply &amp; save" Click="Apply_Click" Style="{StaticResource PrimaryBtn}" MinHeight="38" FontSize="13.5" Margin="0,0,8,8" />
                        <Button Content="Analyze screenshot…" Click="Analyze_Click" Style="{StaticResource SmallBtn}" />
                        <Button Content="Open data folder" Click="OpenData_Click" Style="{StaticResource SmallBtn}" />
                        <Button Content="Open config folder" Click="OpenConfig_Click" Style="{StaticResource SmallBtn}" />
                        <Button Content="Open diagnostics folder" Click="OpenDiagnostics_Click" Style="{StaticResource SmallBtn}" />
                        <Button Content="Open debug snapshots" Click="OpenSnapshots_Click" Style="{StaticResource SmallBtn}" />
                        <Button Content="Learned signatures" Click="OpenLearned_Click" Style="{StaticResource SmallBtn}" />
                        <Button Content="Send pending to GitHub" Click="SendPending_Click" Style="{StaticResource SmallBtn}" />
                        <Button Content="Change user / key…" Click="ChangeLicense_Click" Style="{StaticResource SmallBtn}" ToolTip="Forget this activation and ask for a name and key again" />
                        <Button Content="Run self-test" Click="SelfTest_Click" Style="{StaticResource SmallBtn}" ToolTip="Checks OCR, capture, database and monitors on this PC and opens a report" />
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- ───────────── footer ───────────── -->
            <DockPanel Margin="0,20,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Exit app" Click="Exit_Click" Margin="10,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Hide to tray" Click="Hide_Click" Margin="10,0,0,0" />
                <TextBlock Text="Reads the screen only. No memory access, no input automation." Style="{StaticResource Hint}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

<Window x:Class="MiningAssistant.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mining Assistant Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False" Topmost="True"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        IsHitTestVisible="False"
        FontFamily="Bahnschrift, Segoe UI" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- Idle: nearly invisible pill -->
        <Border x:Name="IdlePanel" CornerRadius="10" Padding="8,3" Background="#660A0E14"
                HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.35">
            <TextBlock x:Name="IdleText" Foreground="#FFCBD5E1" FontSize="11" Text="⛏ scanning" />
        </Border>

        <!-- Result card -->
        <Border x:Name="Card" CornerRadius="8" Background="#E60A0E14" BorderThickness="1.5"
                BorderBrush="#FF4ADE80" MinWidth="210" Visibility="Collapsed"
                MouseLeftButtonDown="Card_MouseDown" MouseMove="Card_MouseMove" MouseLeftButtonUp="Card_MouseUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar" Grid.Column="0" CornerRadius="7,0,0,7" Background="#FF4ADE80" />
                <StackPanel Grid.Column="1" Margin="12,8,14,10">
                    <DockPanel>
                        <TextBlock x:Name="HeldText" DockPanel.Dock="Right" Foreground="#FF94A3B8" FontSize="10" Text="" />
                        <TextBlock x:Name="ContextText" DockPanel.Dock="Right" Foreground="#FF94A3B8" FontSize="10" Margin="10,0,8,0" Text="" />
                        <TextBlock Foreground="#FF94A3B8" FontSize="10" Text="⛏ MINING ASSISTANT" />
                    </DockPanel>
                    <TextBlock x:Name="TargetText" Foreground="#FF0A0E14" Background="#FFFACC15" FontWeight="Bold" FontSize="12"
                               Padding="6,1" Margin="0,6,0,0" HorizontalAlignment="Left" Text="◎ TARGET FOUND" Visibility="Collapsed" />
                    <TextBlock x:Name="Headline" Foreground="#FF4ADE80" FontSize="28" FontWeight="Bold" Margin="0,4,0,0" Text="GOLD" />
                    <TextBlock x:Name="RsText" Foreground="#FFF1F5F9" FontSize="16" Text="RS 3,585" />
                    <TextBlock x:Name="RocksText" Foreground="#FFF1F5F9" FontSize="16" FontWeight="SemiBold" Text="1 ROCK" />
                    <TextBlock x:Name="PriorityText" Foreground="#FF4ADE80" FontSize="13" FontWeight="SemiBold" Margin="0,6,0,0" Text="★★ VERY HIGH PRIORITY" />
                    <TextBlock x:Name="NoteText" Foreground="#FFCBD5E1" FontSize="11.5" Margin="0,2,0,0" Text="" TextWrapping="Wrap" MaxWidth="260" />
                    <TextBlock x:Name="ConfidenceText" Foreground="#FFCBD5E1" FontSize="12" Margin="0,2,0,0" Text="" />
                    <ItemsControl x:Name="AltList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="#FFFDBA74" FontSize="13" FontWeight="SemiBold" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="StatusText" Foreground="#FF94A3B8" FontSize="10" Margin="0,4,0,0" Text="" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

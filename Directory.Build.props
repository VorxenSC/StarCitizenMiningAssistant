<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Company>Star Citizen Mining Assistant (community tool, not affiliated with CIG)</Company>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Windows TFM for projects that need WinRT (Windows.Media.Ocr) and GDI capture. -->
    <WindowsTfm>net8.0-windows10.0.19041.0</WindowsTfm>
  </PropertyGroup>
</Project>

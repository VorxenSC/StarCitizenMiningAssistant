{
  // Preset used until you calibrate. With auto-locate (default) the "rs" region is a SEARCH AREA:
  // the app looks inside it for the amber RS plate (pin icon + number), wherever the HUD sways to,
  // and reads only the digits inside the plate. Keep it generous: the central third of the screen.
  // On 3440x1440 the plate rests around x=50%, y=33% and moves by +-150 px with ship motion.
  // Regions are fractions of the monitor, so this works at any resolution / aspect ratio.
  "name": "default",
  "calibratedWidth": 3440,
  "calibratedHeight": 1440,
  "regions": {
    "rs": { "xPercent": 0.30, "yPercent": 0.12, "widthPercent": 0.40, "heightPercent": 0.46 }
  }
}
